        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गुडफूड आपके साथ वजन और एक स्वस्थ आहार के लक्ष्य तक पहुंचने के लिए है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
