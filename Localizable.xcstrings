    "Chỉ cần chụp ảnh, GoodFood sẽ phân tích nguyên liệu và tính toán dinh dưỡng cho bạn." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما عليك سوى التقاط الصور ، سيقوم Goodfood بتحليل المواد الخام وحساب التغذية لك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Machen Sie einfach Fotos, Goodfood analysiert die Rohstoffe und berechnen Sie die Ernährung für Sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just take photos, Goodfood will analyze the raw materials and calculate nutrition for you."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prenez simplement des photos, GoodFood analysera les matières premières et calculera la nutrition pour vous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बस तस्वीरें लें, गुडफूड कच्चे माल का विश्लेषण करेगा और आपके लिए पोषण की गणना करेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambil saja foto, Goodfood akan menganalisis bahan baku dan menghitung nutrisi untuk Anda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真を撮るだけで、GoodFoodは原材料を分析し、栄養を計算します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진을 찍고 Goodfood는 원료를 분석하고 영양을 계산합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya ambil gambar, Goodfood akan menganalisis bahan mentah dan mengira pemakanan untuk anda."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basta tirar fotos, o GoodFood analisará as matérias -primas e calculará a nutrição para você."
