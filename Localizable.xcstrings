    "Ứng dụng giúp bạn theo dõi calo, quản lý dinh dưỡng và ăn uống thông minh hơn mỗi ngày." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يساعدك التطبيق على تتبع السعرات الحرارية وإدارة التغذية وتناول الطعام أكثر ذكاءً كل يوم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anwendung hilft Ihnen, Kalorien, Ernährungsmanagement und täglich klüger zu essen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The application helps you track calories, nutrition management and eating smarter every day."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'application vous aide à suivre les calories, la gestion de la nutrition et la consommation de plus intelligente chaque jour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एप्लिकेशन आपको हर दिन कैलोरी, पोषण प्रबंधन और खाने को ट्रैक करने में मदद करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi ini membantu Anda melacak kalori, manajemen nutrisi, dan makan lebih pintar setiap hari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリケーションは、毎日カロリー、栄養管理、より賢い食事を追跡するのに役立ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 응용 프로그램은 칼로리, 영양 관리 및 매일 더 똑똑한 식사를 추적하는 데 도움이됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi ini membantu anda mengesan kalori, pengurusan pemakanan dan makan lebih pintar setiap hari."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O aplicativo ajuda a rastrear calorias, gerenciamento de nutrição e comer mais inteligente todos os dias."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O aplicativo ajuda a rastrear calorias, gerenciamento de nutrição e comer mais inteligente todos os dias."
