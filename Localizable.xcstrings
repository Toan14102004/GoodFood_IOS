    "Muốn ăn ngon mà không ăn năn thì vận động đi bạn nhé!" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كنت تريد أن تأكل بشكل جيد دون توبة ، فتمرين!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie gut essen möchten, ohne Buße zu tun, dann trainieren Sie!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you want to eat well without repenting, then exercise!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous voulez bien manger sans vous repentir, alors faites de l'exercice!"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यदि आप पश्चाताप किए बिना अच्छा खाना चाहते हैं, तो व्यायाम करें!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika Anda ingin makan dengan baik tanpa bertobat, maka berolahraga!"
