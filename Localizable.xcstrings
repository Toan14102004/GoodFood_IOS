    "GoodFood đồng hành cùng bạn đạt mục tiêu cân nặng và chế độ ăn lành mạnh." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرافقك Goodfood للوصول إلى هدف الوزن ونظام غذائي صحي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goodfood begleitet Sie, um das Ziel des Gewichts und einer gesunden Ernährung zu erreichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goodfood accompanies you to reach the goal of weight and a healthy diet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goodfood vous accompagne pour atteindre l'objectif du poids et une alimentation saine."
